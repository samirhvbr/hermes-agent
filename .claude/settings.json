{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_perfil": "THIS FILE DOES NOT CHOOSE THE MODEL, ON PURPOSE (24/09/2026 — repodocs ADR-027). No `model`, no `fallbackModel`, and nothing in `env` that steers one: no `ANTHROPIC_MODEL`, no `ANTHROPIC_DEFAULT_*_MODEL`, no `CLAUDE_CODE_SUBAGENT_MODEL`. The model is the user's choice, made with /model, and a subagent inherits it. The highest effortLevel a FILE accepts is 'xhigh'; use /effort max for a single session.",
  "effortLevel": "xhigh",
  "permissions": {
    "_comment": "Projeto Python (uv + pytest) que roda como gateway em Docker. O boundary real e o SO (ver SECURITY_GUIDELINES.md) — as regras abaixo evitam acidentes, nao substituem isolamento.",
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(scripts/run_tests.sh:*)",
      "Bash(uv run:*)",
      "Bash(uv pip list:*)",
      "Bash(uv lock:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -c:*)",
      "Bash(ruff:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(hermes doctor:*)",
      "Bash(hermes version:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose build:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.hermes/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(uv pip install:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose restart:*)",
      "Bash(./deploy.sh:*)",
      "Bash(gh pr create:*)"
    ]
  }
}
